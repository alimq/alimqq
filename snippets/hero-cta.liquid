{{ 'css/hero-cta.css' | asset_url | stylesheet_tag | safe }}
<div class="hero-cta">
    <p class="cta-p subtitle">
        Custom-coded Shopify stores - faster, fewer apps, fully editable
    </p>
    <div class="cta-block">
        <select id="multiSelect" name="features" multiple size="">
            <option value="option1">Fix/bug in a theme</option>
            <option value="option2">Simple section</option>
            <option value="option3">Dynamic feature</option>
            <option value="option4">Replace app with native sections</option>
            <option value="option5">Speed optimization</option>
            <option value="option6">Shop based on Figma</option>
        </select>
        <p class="cta-price">
            
        </p>
        <a href="https://www.upwork.com/freelancers/~01dfbd9e330f3accb6" target="_blank">
            <button class="cta-talk" id="cta-talk">
                Hire me on Upwork
                <img src="{{ 'upwork.svg' | asset_url }}" class="btn-pic">
            </button>
        </a>
    </div>
</div>