<script>
    let videos=document.querySelectorAll('.video-1');
    function videoIsPlaying(video) {
        return (!video.querySelector('video').paused && !video.querySelector('video').ended && video.querySelector('video').readyState > 2);
    }
    function removePlayAddPauseButton(video) {
        video.querySelector('.play-pause').classList.remove('hidden');
        video.querySelector('.video-pause').classList.remove('hidden');
        video.querySelector('.video-play').classList.add('hidden');
    }
    function removePauseAddPlayButton(video) {
        video.querySelector('.play-pause').classList.remove('hidden');
        video.querySelector('.video-pause').classList.add('hidden');
        video.querySelector('.video-play').classList.remove('hidden');
    }
    function removeAllButtons(video) {
        video.querySelector('.play-pause').classList.add('hidden');
    }
    function handleMouseClick(video) {
        if(videoIsPlaying(video)) {
            video.querySelector('video').pause();
            removePauseAddPlayButton(video);
        }   else {
            video.querySelector('video').play();
            removePlayAddPauseButton(video);
            setTimeout(() => removeAllButtons(video), 300);
        }
    }
    function handleMouseEnter(video) {
        if(videoIsPlaying(video)) {
            removePlayAddPauseButton(video);
            setTimeout(() => removeAllButtons(video), 600);
        }
    }
    function handleMouseLeave(video) {
        if(videoIsPlaying(video)) {
            removeAllButtons(video);
        }
    }
    function handleTap(video) {
        if(videoIsPlaying(video)) {
            video.querySelector('video').pause();
            removePauseAddPlayButton(video);
        }   else {
            video.querySelector('video').play();
            removePlayAddPauseButton(video);
            setTimeout(() => removeAllButtons(video), 300);
        }
    }
    if(window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        videos.forEach(video => {
            video.addEventListener('click',() => handleMouseClick(video));
            video.addEventListener('mouseenter',() => handleMouseEnter(video));
            video.addEventListener('mouseleave',() => handleMouseLeave(video));
        });
    }   else {
        videos.forEach(video => {
            video.addEventListener('click',() => handleTap(video));
        });
    }
</script>