<div class="hero portfolio">
    <div class="hero-wrapper">
        <p class="cta-p subtitle">
        TEALAND, an example from portfolio
        </p>
        <div class="container">
            <div class="video-1">
                <video controls muted preload="none" class="video-1"
                src="{{ 'demo.mp4' | asset_url }}" poster="{{ 'demo.png' | asset_url }}">
                </video>
            </div>
            <div class="buttons">
                <a target="_blank" href="work/tealand">
                    <button class="cta-talk">
                        Go to page
                    </button>
                </a>
                <form style="display: inline" method="post" target="_blank" action="https://tealand-sep-14-i7j8qdux.myshopify.com/password">
                    <input type="hidden" name="form_type" value="storefront_password">
                    <input type="hidden" name="password" value="alimqq">
                    <input type="hidden" name="utf8" value="alimqq">
                    <button class="cta-talk" type="submit">
                        Go to site
                    </button>
                </form>
                <a target="_blank" href="full-portfolio">
                    <button class="cta-talk">
                        Go to portfolio
                    </button>
                </a>
            </div>
        </div>
    </div>
</div>
<script>
    const popupEl3=document.getElementById('modal-2');
    const wrapper3=document.querySelectorAll('.wrapper')[0];
    const siteLinks3=document.querySelectorAll('.site-link');
    const link=document.getElementById('site-link-2');
    function siteHandle(event) {
        if(!popupEl3.classList.contains('visible')) {
            event.preventDefault();
            event.stopPropagation();
            const el = event.currentTarget;
            const text1 = el.dataset.link;
            let text2="alimqq";
            navigator.clipboard.writeText(text2);
            popupEl3.classList.add('visible');
            wrapper3.classList.add('is-background');
            link.href=text1;
        }
    }
    siteLinks3.forEach((siteLink) => {
        siteLink.addEventListener('click',siteHandle);
        document.addEventListener('click', (event) => {
            const isClickInside=popupEl3.contains(event.target);
            const isClickOnOpenBtn=siteLink.contains(event.target);
            if(!isClickInside && !isClickOnOpenBtn) {
                popupEl3.classList.remove('visible');
                wrapper3.classList.remove('is-background');
            }
        });
    });
</script>