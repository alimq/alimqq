<div class="hero portfolio">
    <div class="hero-wrapper">
        <p class="cta-p subtitle">
        TEALAND, an example from portfolio
        </p>
        <div class="container">
            <div class="video-1">
                <video muted preload="none" class="video-1"
                src="{{ 'demo.mp4' | asset_url }}" poster="{{ 'demo.png' | asset_url }}">
                </video>
                <button class="play-pause">
                    <img class="video-play" src="{{
                        'play.svg' | asset_url
                    }}">
                    <img class="video-pause hidden" src="{{
                        'pause.svg' | asset_url
                    }}">
                </button>
            </div>
            <div class="buttons">
                <a target="_blank" href="work/tealand">
                    <button class="cta-talk">
                        See details
                    </button>
                </a>
                <form style="display: inline" method="post" target="_blank" action="https://tealand-sep-14-i7j8qdux.myshopify.com/password">
                    <input type="hidden" name="form_type" value="storefront_password">
                    <input type="hidden" name="password" value="alimqq">
                    <input type="hidden" name="utf8" value="alimqq">
                    <button class="cta-talk" type="submit">
                        Go to site (Password: alimqq)
                    </button>
                </form>
                <a target="_blank" href="full-portfolio">
                    <button class="cta-talk">
                        Go to portfolio
                    </button>
                </a>
                <a href="https://www.upwork.com/freelancers/~01dfbd9e330f3accb6" target="_blank">
                    <button class="cta-talk" id="cta-talk">
                        Hire me on Upwork
                        <img src="{{ 'upwork.svg' | asset_url }}" class="btn-pic">
                    </button>
                </a>
            </div>
        </div>
    </div>
</div>
<script>
    let videos=document.querySelectorAll('.video-1');
    function handleClick(video) {
        let pauseHidden=video.querySelector('.video-pause').classList.contains('hidden');
        if(pauseHidden) {
            video.querySelector('.video-pause').classList.remove('hidden');
            video.querySelector('.video-play').classList.add('hidden');
            video.querySelector('video').play();
        }   else {
            video.querySelector('.video-pause').classList.add('hidden');
            video.querySelector('.video-play').classList.remove('hidden');
            video.querySelector('video').pause();
        }
    }
    videos.forEach(video => {
        video.addEventListener('click',() => handleClick(video));
    });
</script>