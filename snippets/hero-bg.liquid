{{ 'hero-bg.css' | asset_url | stylesheet_tag }}
<img class="hero-bg" src="{{ 'hero.svg' | asset_url }}">
<img class="hero-bg-gif" src="{{ 'hero.gif' | asset_url }}">
<video class="hero-bg-video" autoplay loop muted playsinline>
    <source src="{{ 'hero.mp4' | asset_url }}" type="video/mp4">
</video>