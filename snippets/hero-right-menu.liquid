{{ 'hero-right-menu.css' | asset_url | stylesheet_tag }}
<img id="popup-menu-btn" class="hero-right-menu" src="{{ 
    'hero-right-menu.svg' | asset_url }}">
<div class="hero-full-right-menu">
    <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/full-portfolio">Full Portfolio</a></li>
        <li><a href="/contacts">Contacts</a></li>
    </ul>
</div>
<script>
    const popupEl2=document.getElementById('popup-menu');
    const popupMenuBtn=document.getElementById('popup-menu-btn');
    function popupHandle() {
        popupEl2.classList.add('visible');
    }
    popupMenuBtn.addEventListener('click',popupHandle);
    document.addEventListener('click', (event) => {
        const isClickInside=popupEl2.contains(event.target);
        const isClickOnOpenBtn=popupMenuBtn.contains(event.target);
        if(!isClickInside && !isClickOnOpenBtn) {
            popupEl2.classList.remove('visible');
        }
    });
</script>