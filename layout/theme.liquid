<!DOCTYPE html>
<html>
<head>
    <title>Alimqq, Shopify Dev - Portfolio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ 'css/theme.css' | asset_url | stylesheet_tag }}
    <link rel="preload" href="{{ 'Inter_18pt-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'CormorantGaramond-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
</head>
<body>
    <div class="modal-type" id="modal" style="display: none;">
        <p id="modal-text"></p>
        <a href="https://www.upwork.com/freelancers/~01dfbd9e330f3accb6" target="_blank">
            <button class="send-btn">
                Send to <img src="{{ 
                    'upwork.svg' | asset_url }}"
                    class="btn-pic">
            </button>
        </a>
    </div>
    <div class="modal-type" id="modal-2" style="display: none;">
        <p id="modal-text-2">
            Copied password "alimqq" to clipboard!
        </p>
        <a href="javascript:void(0)" target="_blank" id="site-link-2">
            <button class="send-btn">
                Go to site
            </button>
        </a>
    </div>
    <div id="popup-menu" style="display: none;">
        <ul>
            <a href="/"><li>
            Home</li></a>
            <a href="/full-portfolio"><li>
            Full Portfolio</li></a>
            <a href="/contacts"><li>
            Contacts</li></a>
        </ul>
    </div>
    {% render 'header' %}
    <div class="wrapper">
        {% block content %}{% endblock %}
    </div>
    <p class="width-text">
    
    </p>
</body>
</html>
