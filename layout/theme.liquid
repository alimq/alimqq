<!DOCTYPE html>
<html>
<head>
    <title>Alimqq, Shopify Dev - Portfolio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {{ 'css/theme.css' | asset_url | stylesheet_tag }}
    <link rel="preload" href="{{ 'Inter_18pt-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'CormorantGaramond-Regular.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
</head>
<body>
    <div id="modal" style="display: none;">
        <p id="modal-text"></p>
        <a href="#" target="_blank" id="whatsapp-link">
            <button class="send-btn">
                Send to <img src="{{ 
                    'whatsapp.svg' | asset_url }}"
                    class="btn-pic">
            </button>
        </a>
        <a href="#" target="_blank" id="telegram-link">
            <button class="send-btn">
                Send to <img src="{{ 
                    'telegram.svg' | asset_url }}"
                    class="btn-pic">
            </button>
        </a>
        <a href="#" target="_blank" id="gmail-link">
            <button class="send-btn">
                Send to <img src="{{ 
                    'gmail.svg' | asset_url }}"
                    class="btn-pic">
            </button>
        </a>
    </div>
    <div id="popup-menu" style="display: none;">
        <ul>
            <a href="/"><li>
            Home</li></a>
            <a href="/full-portfolio"><li>
            Full Portfolio</li></a>
            <a href="/contacts"><li>
            Contacts</li></a>
        </ul>
    </div>
    {% render 'header' %}
    <div class="wrapper">
        {% block content %}{% endblock %}
    </div>
    <p class="width-text">
    Device width must be between 162 and 4096 px.
    </p>
</body>
</html>
