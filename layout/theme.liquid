<!DOCTYPE html>
<html>
<head>
    <title>Express + Liquid</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
    <div class="wrapper">
        {% render 'hero' %}
    </div>
    <p class="width-text">
    Device width must be between 162 and 4096 px.
    </p>
    <style>
        @media (max-width: 161px) {
            .wrapper {
                display: none;
            }
            body {
                padding: 10px;
            }
            .width-text {
                display: inline;
            }
        }
        @media (min-width: 162px) and (max-width: 4096px) {
            .width-text {
                display: none;
            }
        }
        @media (min-width: 4097px) {
            .wrapper {
                display: none;
            }
            body {
                padding: 100px;
            }
            .width-text {
                display: inline;
                font-size: 200px;
            }
        }
    </style>
</body>
</html>
